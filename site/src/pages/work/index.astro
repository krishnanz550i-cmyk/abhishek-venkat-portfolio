---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { works, workFilters, identity, breadcrumbSchema } from '../../lib/content.js';

// Filters are built from what is actually in the catalogue, so a new project
// with a new collection appears in the bar without anyone editing this page.
const usedKinds = workFilters.kinds.filter((k) => works.some((w) => w.kind === k.id));
const usedCollections = workFilters.collections.filter((c) => works.some((w) => w.collection === c.id));

const schema = [
  breadcrumbSchema([{ label: 'Home', href: '/' }, { label: 'Work', href: '/work' }]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `Work — ${identity.name}`,
    numberOfItems: works.length,
  },
];
---
<Base title="Work" description={`Selected music, covers and screen work by ${identity.name} — production, mixing, mastering, composition and sound design.`} schema={schema}>
  <section class="section" style="padding-top:9rem">
    <div class="wrap">
      <p class="tag tag--signal">The catalogue</p>
      <h1 class="display display--poster" style="margin:1rem 0 2rem">Work</h1>
      <p class="lead prose">
        Originals, covers and score written to picture. <span data-work-count>{works.length}</span> projects.
      </p>

      <div class="filters" role="group" aria-label="Filter projects" style="margin-top:3rem">
        <button class="filter is-on" data-filter="all" aria-pressed="true">All</button>
        {usedKinds.map((k) => (
          <button class="filter" data-filter={k.id} aria-pressed="false">{k.label}</button>
        ))}
        <span class="rule" style="width:1px;height:1.6rem;align-self:center" aria-hidden="true"></span>
        {usedCollections.map((c) => (
          <button class="filter" data-filter={c.id} aria-pressed="false">{c.label}</button>
        ))}
      </div>

      <div class="work-grid" data-work-grid>
        {works.map((w, i) => <WorkCard work={w} eager={i < 4} />)}
      </div>

      <p class="lead dim" data-work-empty hidden style="margin-top:3rem">
        Nothing in that category yet.
      </p>
    </div>
  </section>
</Base>
